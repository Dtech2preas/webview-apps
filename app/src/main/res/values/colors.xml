<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- D-TECH Theme Colors -->
    <!-- Backgrounds -->
    <color name="dtech_background_black">#000000</color> <!-- AMOLED Black -->
    <color name="dtech_surface_grey">#121212</color> <!-- Card Surface -->
    <color name="dtech_panel_bg">#1E1E1E</color>

    <!-- Accents -->
    <color name="dtech_cyan">#00E5FF</color> <!-- Primary Action -->
    <color name="dtech_cyan_dim">#4D00E5FF</color>
    <color name="dtech_purple">#D500F9</color> <!-- Secondary Highlight -->
    <color name="dtech_purple_dim">#4DD500F9</color>
    <color name="dtech_red">#FF1744</color> <!-- Alert/Stop -->

    <!-- Text -->
    <color name="dtech_text_primary">#FFFFFF</color>
    <color name="dtech_text_secondary">#B0B0B0</color>
    <color name="dtech_console_green">#69F0AE</color> <!-- Success Log -->
    <color name="dtech_console_red">#FF5252</color> <!-- Failure Log -->
    <color name="dtech_console_info">#00E5FF</color> <!-- Info Log -->

    <!-- Overlays -->
    <color name="dtech_overlay_dim">#E6000000</color> <!-- 90% opacity black -->
    <color name="transparent_black">#CC000000</color>

    <!-- Standard Overrides mapping to D-TECH -->
    <color name="colorPrimary">@color/dtech_cyan</color>
    <color name="colorPrimaryDark">@color/dtech_background_black</color>
    <color name="colorAccent">@color/dtech_purple</color>
</resources>
