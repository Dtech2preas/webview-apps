<resources>

    <!-- D-TECH Base Theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/dtech_background_black</item>
        <item name="android:windowBackground">@color/dtech_background_black</item>

        <item name="colorPrimary">@color/dtech_cyan</item>
        <item name="colorPrimaryVariant">@color/dtech_surface_grey</item>
        <item name="colorOnPrimary">@color/dtech_background_black</item>

        <item name="colorSecondary">@color/dtech_purple</item>
        <item name="colorOnSecondary">@color/dtech_text_primary</item>

        <item name="android:textColor">@color/dtech_text_primary</item>
        <item name="android:textColorPrimary">@color/dtech_text_primary</item>
        <item name="android:textColorSecondary">@color/dtech_text_secondary</item>

        <!-- Enable Material Features -->
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
    </style>

    <!-- Transparent Activity -->
    <style name="Theme.Transparent" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Bottom Sheet Theme -->
    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- D-TECH Card Style -->
    <style name="DTechCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/dtech_surface_grey</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/dtech_cyan</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- D-TECH Text Styles -->
    <style name="DTechTextHeader">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dtech_cyan</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="DTechTextConsole">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/dtech_text_secondary</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- D-TECH Button Style -->
    <style name="DTechButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/dtech_cyan_dim</item>
        <item name="strokeColor">@color/dtech_cyan</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/dtech_cyan</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DTechButton.Accent" parent="DTechButton">
        <item name="backgroundTint">@color/dtech_purple_dim</item>
        <item name="strokeColor">@color/dtech_purple</item>
        <item name="android:textColor">@color/dtech_purple</item>
    </style>

    <style name="DTechButton.Alert" parent="DTechButton">
        <item name="backgroundTint">#4DFF1744</item> <!-- Red Dim -->
        <item name="strokeColor">@color/dtech_red</item>
        <item name="android:textColor">@color/dtech_red</item>
    </style>

</resources>
