<resources>

    <!-- Base Theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">@color/cyber_black</item>
        <item name="android:windowBackground">@color/cyber_black</item>
        <item name="colorPrimary">@color/cyber_cyan</item>
        <item name="colorPrimaryVariant">@color/cyber_dark_gray</item>
        <item name="colorOnPrimary">@color/cyber_black</item>
        <item name="colorSecondary">@color/cyber_red</item>
        <item name="colorOnSecondary">@color/cyber_text_primary</item>
        <item name="android:textColor">@color/cyber_text_primary</item>

        <!-- Enable Material Features -->
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
    </style>

    <!-- Transparent Activity for Stealth Mode or Dialogs -->
    <style name="Theme.Transparent" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Bottom Sheet Theme -->
    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_control_deck</item>
    </style>

    <!-- Cyberpunk Button Style -->
    <style name="CyberButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/cyber_cyan_dim</item>
        <item name="strokeColor">@color/cyber_cyan</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/cyber_cyan</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CyberButton.Alert" parent="CyberButton">
        <item name="backgroundTint">@color/cyber_red_dim</item>
        <item name="strokeColor">@color/cyber_red</item>
        <item name="android:textColor">@color/cyber_red</item>
    </style>

    <!-- Card Style -->
    <style name="CyberCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/cyber_dark_gray</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/cyber_cyan_dim</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
