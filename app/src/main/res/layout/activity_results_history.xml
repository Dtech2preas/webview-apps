<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dtech_background_black"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="@color/dtech_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESULTS &amp; ANALYTICS"
            style="@style/DTechTextHeader"
            android:layout_marginStart="12dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btn_share_all"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            app:tint="@color/dtech_purple" />

    </LinearLayout>

    <!-- Filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_filter_all"
            style="@style/DTechButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="GLOBAL HISTORY"
            android:textSize="10sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_filter_session"
            style="@style/DTechButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="SESSION ONLY"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Chart Area -->
    <com.google.android.material.card.MaterialCardView
        style="@style/DTechCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pie_chart_view"
                android:layout_width="140dp"
                android:layout_height="140dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp">

                <TextView
                    android:id="@+id/tv_stat_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: 0"
                    android:textColor="@color/dtech_text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_stat_success"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Success: 0"
                    android:textColor="@color/dtech_green"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tv_stat_failure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Failures: 0"
                    android:textColor="@color/dtech_red"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tv_stat_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Success Rate: 0%"
                    android:textColor="@color/dtech_cyan"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons (Conditional) -->
    <LinearLayout
        android:id="@+id/layout_session_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_export_success"
            style="@style/DTechButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="COPY SUCCESS"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_clear_session"
            style="@style/DTechButton.Alert"
            android:layout_width="wrap_content"
            android:text="CLEAR LOG"
            android:textSize="10sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DETAILED LOGS"
        android:textColor="@color/dtech_text_secondary"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/list_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_capsule_status"
        android:backgroundTint="@color/dtech_surface_grey"
        android:padding="8dp"
        android:divider="@color/dtech_panel_bg"
        android:dividerHeight="1dp"/>

</LinearLayout>
