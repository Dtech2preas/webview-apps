<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/dtech_surface_grey"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_group_service"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SERVICE NAME"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tv_group_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S:0 F:0"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/iv_group_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/arrow_down_float"
            app:tint="#00E5FF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">
        <View
            android:id="@+id/view_group_success_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#00C853" />
        <View
            android:id="@+id/view_group_fail_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#D50000" />
    </LinearLayout>

</LinearLayout>
