<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DTECH"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tv_header"
        android:layout_above="@id/tv_footer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Quick Start Card -->
            <LinearLayout
                android:id="@+id/card_quick_resume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUICK RESUME"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tv_last_service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btn_quick_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RUN AUTOMATION"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button"
                    android:textAllCaps="true" />
            </LinearLayout>

            <!-- Main Menu Buttons -->
            <Button
                android:id="@+id/btn_open_automation"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Open Automation"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btn_results_history"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Results History"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btn_ad_system"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Ad System"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button"
                android:layout_marginBottom="16dp"/>

             <Button
                android:id="@+id/btn_info_help"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Info &amp; Help"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Made by Preasx24"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"/>

</RelativeLayout>