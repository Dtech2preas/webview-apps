<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tv_terminal_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="> System Init..."
        android:textColor="#00E5FF"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.2"
        android:gravity="bottom"
        android:paddingBottom="16dp"/>

    <ProgressBar
        android:id="@+id/progress_unlock"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:progressTint="#00E5FF"
        android:layout_marginBottom="32dp"/>

    <ImageView
        android:id="@+id/iv_lock_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@android:drawable/ic_lock_lock"
        app:tint="#FF1744"
        android:layout_marginBottom="16dp"
        android:visibility="invisible"/>

    <TextView
        android:id="@+id/tv_lock_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENCRYPTED CONTENT"
        android:textColor="#FF1744"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        android:visibility="invisible"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_unlock_action"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="UNLOCK CONFIGURATION"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:backgroundTint="#FF1744"
        android:visibility="invisible"/>

</LinearLayout>
